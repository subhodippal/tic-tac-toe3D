{
  "name": "Tic Tac Toe 3D",
  "short_name": "XO 3D",
  "description": "Neon 3D tic tac toe: 3×3 to 10×10, 2–4 players, vs computer, pass & play, or online with friends.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
